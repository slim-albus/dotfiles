[init]
    defaultBranch = main
[pull]
    rebase = false
[fetch]
    prune = true
[push]
    autoSetupRemote = true
[rerere]
    enabled = true
[merge]
    conflictStyle = zdiff3
[diff]
    algorithm = histogram
[color]
    ui = auto
[core]
    editor = micro
    pager = delta
    excludesFile = ~/.config/git/ignore
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = false
    line-numbers = true
    side-by-side = false
[include]
    path = ~/.gitconfig.local