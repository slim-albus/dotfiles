[init]
    defaultBranch = main
[pull]
    rebase = false
[fetch]
    prune = true
[push]
    autoSetupRemote = true
[rerere]
    enabled = true
[merge]
    conflictStyle = zdiff3
[diff]
    algorithm = histogram
[color]
    ui = auto
[core]
    editor = micro
    excludesFile = ~/.config/git/ignore