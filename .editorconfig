root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{json,jsonc,yaml,yml,toml}]
indent_size = 2

[*.{ps1,psm1}]
end_of_line = crlf

[Makefile]
indent_style = tab